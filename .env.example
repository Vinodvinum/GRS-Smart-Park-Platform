# ============================================================
# GRS Smart Park Platform — Environment variables
# ============================================================
# Copy this file to .env for local development. NEVER commit .env
# with real values. All secrets are injected per-environment at
# runtime (local / test / preview / production) and are never stored
# in source control.
#
# See docs/DEPLOYMENT.md for the full per-environment mapping.

# ---- Required in every environment ----
# Managed PostgreSQL connection string. Production / preview must
# NOT point at grs_smart_park_test or local PostgreSQL.
DATABASE_URL="postgresql://grs:grs_dev_password@localhost:5432/grs_smart_park?schema=public"

# Required by Auth.js (JWT signing). Generate with:
#   openssl rand -base64 32
# Use a UNIQUE value per environment; never the dev value in prod.
AUTH_SECRET="replace-with-at-least-32-random-bytes"

# ---- Optional / advanced ----
# Rate-limit provider selection. Only "in-memory" is implemented.
# A shared provider (e.g. Upstash Redis / Vercel KV) is a DEPLOYMENT
# PREREQUISITE for horizontally-scaled / serverless production and is
# intentionally NOT claimed as implemented. Omitting selects in-memory.
# RATE_LIMIT_PROVIDER="in-memory"

# ---- Demo seed overrides (dev/test only, never production) ----
# Optional overrides for demo account passwords during seeding.
# If unset, the seed uses its bundled demo bcrypt hashes. The seed
# refuses to run when NODE_ENV=production.
# GRS_DEMO_GUEST_PASSWORD=""
# GRS_DEMO_STAFF_PASSWORD=""
# GRS_DEMO_SUPERVISOR_PASSWORD=""
# GRS_DEMO_ADMIN_PASSWORD=""
